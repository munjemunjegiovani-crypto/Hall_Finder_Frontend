# URL of the HallFinder backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Name shown on the landing page and in the header
NEXT_PUBLIC_SCHOOL_NAME=Horizon International College

# "true" starts every new visitor on a simulated Monday 10:00 so the demo always has classes to show.
# Set to "false" for a real school: the app then follows the real clock.
NEXT_PUBLIC_DEMO_MODE=true
